{
  "name": "pixi-blackjack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "atlas": "node scripts/generate-atlas.mjs",
    "dev": "next dev",
    "dev:server": "cd server && npm run dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --experimental-strip-types --test scripts/six-cards-rules.test.mjs",
    "build:server": "rm -rf .deploy && mkdir -p .deploy/server .deploy/src/game && cp -r server/src server/package.json server/tsconfig.json .deploy/server/ && cp -r src/game/. .deploy/src/game/",
    "deploy:server": "npm run build:server && ~/.codebuddy/skills/lighthouse-deploy/scripts/deploy.sh bj-server ./.deploy 8080 api.game.convenience.top server"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "pixi.js": "^8.6.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
